{
  "name": "@ihorleleka/wiki-kit",
  "version": "0.1.12",
  "description": "Installer and runner assets for wiki-manager agent wiki-kit integration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihorleleka/Local-Rag-Wiki.git"
  },
  "bin": {
    "wiki-kit": "bin/wiki-kit.js"
  },
  "main": "./packages/dsh-local-rag-wiki/index.mjs",
  "exports": {
    ".": "./packages/dsh-local-rag-wiki/index.mjs",
    "./dsh": "./packages/dsh-local-rag-wiki/index.mjs",
    "./dsh-mcp-client": "./templates/root/.dsh/.dsh-mcp-client.js",
    "./dsh-runner": "./packages/dsh-local-rag-wiki/workspace-runner.cjs",
    "./dsh.bundle.patch": "./packages/dsh-local-rag-wiki/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/dsh-local-rag-wiki/cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "npm run verify",
    "verify": "node scripts/verify.js && node scripts/verify-dsh-mcp.js",
    "verify:dsh-mcp": "node scripts/verify-dsh-mcp.js",
    "verify:runner": "node scripts/verify-runner.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "templates/",
    "packages/dsh-local-rag-wiki/",
    "README.md"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-scope": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "engines": {
    "node": ">=18"
  }
}
